{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "userauth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "sites-route": {
        "ClusterId": "urlsubmission-cluster",
        "Match": { "Path": "/api/sites/{**catch-all}" }
      },
      "search-route": {
        "ClusterId": "searchranking-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" }
      }
    },
    "Clusters": {
      "userauth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://userauthservice:8080" }
        }
      },
      "urlsubmission-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://urlsubmissionservice:8080" }
        }
      },
      "searchranking-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://searchrankingservice:8080" }
        }
      }
    }
  }
}